<%- include('partials/header') %>

<main class="category-page">

    <section class="page-intro">
        <h1><%= category.category_name %></h1>

        <p>
            Explore service projects available in the
            <%= category.category_name %> category.
        </p>
    </section>


    <% if (projects && projects.length > 0) { %>

        <section
            class="projects-list"
            aria-label="Service projects in this category"
        >

            <% projects.forEach(project => { %>

                <article class="project-card">

                    <h2>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h2>

                    <p>
                        <%= project.description %>
                    </p>

                    <p>
                        <strong>Partner Organization:</strong>
                        <%= project.organization_name %>
                    </p>

                    <p>
                        <strong>Start Date:</strong>
                        <%= project.start_date %>
                    </p>

                    <% if (project.end_date) { %>
                        <p>
                            <strong>End Date:</strong>
                            <%= project.end_date %>
                        </p>
                    <% } %>

                </article>

            <% }) %>

        </section>

    <% } else { %>

        <p class="no-results">
            There are currently no service projects in this category.
        </p>

    <% } %>

</main>

<%- include('partials/footer') %>