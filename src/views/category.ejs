<%- include('partials/header') %>

<main class="category-page">

    <!-- Category Introduction -->
    <section class="page-intro">

        <h1><%= category.category_name %></h1>

        <p>
            Explore service projects available in the
            <%= category.category_name %> category.
        </p>

    </section>


    <!-- Projects in This Category -->
    <% if (projects && projects.length > 0) { %>

        <section
            class="projects-list"
            aria-labelledby="category-projects-heading"
        >

            <h2 id="category-projects-heading">
                Service Projects
            </h2>

            <div class="projects-grid">

                <% projects.forEach(project => { %>

                    <article class="project-card">

                        <h3>
                            <%= project.title %>
                        </h3>

                        <p>
                            <%= project.description %>
                        </p>

                        <div class="project-details">

                            <p>
                                <strong>Start Date:</strong>
                                <%= new Date(project.start_date).toLocaleDateString() %>
                            </p>

                            <p>
                                <strong>End Date:</strong>
                                <%= new Date(project.end_date).toLocaleDateString() %>
                            </p>

                            <p>
                                <strong>Partner Organization:</strong>
                                <%= project.organization_name %>
                            </p>

                        </div>

                        <div class="card-actions">

                            <a
                                href="/project/<%= project.project_id %>"
                                class="button"
                            >
                                View Project
                            </a>

                        </div>

                    </article>

                <% }) %>

            </div>

        </section>

    <% } else { %>

        <!-- No Projects -->
        <section class="empty-state">

            <h2>No Service Projects Available</h2>

            <p>
                There are currently no service projects assigned
                to this category.
            </p>

            <a
                href="/projects"
                class="button"
            >
                View All Projects
            </a>

        </section>

    <% } %>

</main>

<%- include('partials/footer') %>