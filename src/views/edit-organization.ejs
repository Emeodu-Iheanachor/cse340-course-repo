<%- include('partials/header') %>

<main>

  <section class="page-intro">

    <h1><%= title %></h1>

    <p>
      Update the information for this partner organization.
    </p>

  </section>


  <section class="organization-form-page">

    <form
      class="organization-form"
      action="/edit-organization/<%= organizationDetails.organization_id %>"
      method="POST"
    >

      <div class="form-group">

        <label for="name">
          Organization Name
        </label>

        <input
          type="text"
          id="name"
          name="name"
          value="<%= organizationDetails.name %>"
          maxlength="150"
          required
        />

      </div>


      <div class="form-group">

        <label for="description">
          Description
        </label>

        <textarea
          id="description"
          name="description"
          maxlength="500"
          required
        ><%= organizationDetails.description %></textarea>

      </div>


      <div class="form-group">

        <label for="contactEmail">
          Contact Email
        </label>

        <input
          type="email"
          id="contactEmail"
          name="contactEmail"
          maxlength="255"
          value="<%= organizationDetails.contact_email %>"
          required
        />

      </div>


      <div class="form-group">

        <label for="logoFilename">
          Logo Filename
        </label>

        <input
          type="text"
          id="logoFilename"
          name="logoFilename"
          maxlength="255"
          value="<%= organizationDetails.logo_filename %>"
          required
        />

      </div>


      <div class="form-actions">

        <button type="submit" class="button">
          Update Organization
        </button>

        <a
          href="/organization/<%= organizationDetails.organization_id %>"
          class="button button-secondary"
        >
          Cancel
        </a>

      </div>

    </form>

  </section>

</main>

<%- include('partials/footer') %>
