<%- include('partials/header') %>

<main> <section class="page-hero"> <h1><%= title %></h1>

    <p>
        Our partner organizations work with the CSE 340 Service Network
        to provide meaningful service opportunities to volunteers.
    </p>
</section>

<section class="organizations">

    <% organizations.forEach(organization => { %>

        <article class="organization-card">
            <img
                src="/images/<%= organization.logo_filename %>"
                alt="<%= organization.name %> logo"
                class="organization-logo"
            >

            <h2><%= organization.name %></h2>

            <p>
                <%= organization.description %>
            </p>

            <p>
                Contact: <%= organization.contact_email %>
            </p>
        </article>

    <% }); %>

</section>

</main>

<%- include('partials/footer') %>