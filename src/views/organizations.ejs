<%- include('partials/header') %>

<main class="organizations-page">

    <!-- =====================================================
         PAGE INTRODUCTION
    ====================================================== -->

    <section class="page-intro">

        <h1><%= title %></h1>

        <p>
            Explore our partner organizations and discover
            meaningful opportunities to serve in the community.
        </p>

    </section>


    <!-- =====================================================
         ORGANIZATION LIST
    ====================================================== -->

    <% if (organizations && organizations.length > 0) { %>

        <section
            class="organization-list"
            aria-label="Partner organizations"
        >

            <% organizations.forEach(organization => { %>

                <article class="organization-card">

                    <!-- Organization Logo -->

                    <div class="organization-card-image">

                        <img
                            src="/images/<%= organization.logo_filename %>"
                            alt="<%= organization.name %> logo"
                        >

                    </div>


                    <!-- Organization Information -->

                    <div class="organization-card-content">

                        <h2>
                            <a href="/organization/<%= organization.organization_id %>">
                                <%= organization.name %>
                            </a>
                        </h2>

                        <p>
                            <%= organization.description %>
                        </p>

                        <p>
                            <strong>Contact:</strong>

                            <a href="mailto:<%= organization.contact_email %>">
                                <%= organization.contact_email %>
                            </a>
                        </p>


                        <!-- View Organization -->

                        <a
                            class="project-link"
                            href="/organization/<%= organization.organization_id %>"
                        >
                            View Organization
                        </a>

                    </div>

                </article>

            <% }) %>

        </section>


    <!-- =====================================================
         EMPTY STATE
    ====================================================== -->

    <% } else { %>

        <section class="empty-state">

            <h2>No Partner Organizations Available</h2>

            <p>
                There are currently no partner organizations available.
                Please check back later.
            </p>

        </section>

    <% } %>


    <!-- =====================================================
         ADMINISTRATOR ACTIONS
         Only administrators can add organizations.
    ====================================================== -->

    <% if (isAdmin) { %>

        <section class="admin-actions">

            <a
                href="/new-organization"
                class="project-link"
            >
                Add a New Organization
            </a>

        </section>

    <% } %>

</main>

<%- include('partials/footer') %>
