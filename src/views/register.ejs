<%- include('partials/header') %>

<main class="register-page">

    <section class="page-intro">
        <h1><%= title %></h1>

        <p>
            Create an account to access Service Network.
        </p>
    </section>


    <!-- =====================================================
         FLASH MESSAGES
    ====================================================== -->

    <% if (flash) { %>

        <% if (flash.success && flash.success.length > 0) { %>

            <div class="flash-messages">

                <% flash.success.forEach(message => { %>

                    <div class="flash flash-success">
                        <%= message %>
                    </div>

                <% }) %>

            </div>

        <% } %>


        <% if (flash.error && flash.error.length > 0) { %>

            <div class="flash-messages">

                <% flash.error.forEach(message => { %>

                    <div class="flash flash-error">
                        <%= message %>
                    </div>

                <% }) %>

            </div>

        <% } %>


        <% if (flash.notice && flash.notice.length > 0) { %>

            <div class="flash-messages">

                <% flash.notice.forEach(message => { %>

                    <div class="flash flash-notice">
                        <%= message %>
                    </div>

                <% }) %>

            </div>

        <% } %>


        <% if (flash.warning && flash.warning.length > 0) { %>

            <div class="flash-messages">

                <% flash.warning.forEach(message => { %>

                    <div class="flash flash-warning">
                        <%= message %>
                    </div>

                <% }) %>

            </div>

        <% } %>


        <% if (flash.info && flash.info.length > 0) { %>

            <div class="flash-messages">

                <% flash.info.forEach(message => { %>

                    <div class="flash flash-info">
                        <%= message %>
                    </div>

                <% }) %>

            </div>

        <% } %>

    <% } %>


    <!-- =====================================================
         REGISTRATION FORM
    ====================================================== -->

    <section class="form-section">

        <form
            class="service-form"
            action="/register"
            method="POST"
        >

            <!-- NAME -->

            <div class="form-group">

                <label for="name">
                    Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                    minlength="2"
                    maxlength="100"
                    autocomplete="name"
                    required
                >

            </div>


            <!-- EMAIL -->

            <div class="form-group">

                <label for="email">
                    Email (Username)
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email address"
                    maxlength="100"
                    autocomplete="email"
                    required
                >

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Create a password"
                    minlength="7"
                    autocomplete="new-password"
                    required
                >

                <small>
                    Password must be at least 7 characters long.
                </small>

            </div>


            <!-- FORM ACTIONS -->

            <div class="form-actions">

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Register
                </button>


                <a
                    href="/login"
                    class="btn btn-secondary"
                >
                    Already have an account? Log in
                </a>

            </div>

        </form>

    </section>

</main>

<%- include('partials/footer') %>
