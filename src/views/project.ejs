<%- include('partials/header') %>

<main class="project-page">

    <!-- =====================================================
         PROJECT INTRODUCTION
    ====================================================== -->

    <section class="page-intro">

        <h1><%= title %></h1>

        <p>
            Learn more about this service project and the
            organization supporting this opportunity.
        </p>

    </section>


    <!-- =====================================================
         PROJECT DETAILS
    ====================================================== -->

    <section
        class="project-details"
        aria-label="Service project details"
    >

        <article class="project-card">

            <div class="project-card-content">

                <p class="project-label">
                    Service Project
                </p>

                <h2><%= project.title %></h2>


                <!-- Project Description -->

                <div class="project-detail-section">

                    <h3>Description</h3>

                    <p class="project-description">
                        <%= project.description || 'No description is available for this project.' %>
                    </p>

                </div>


                <!-- =================================================
                     PROJECT INFORMATION
                ================================================== -->

                <div class="project-details-list">

                    <!-- Partner Organization -->

                    <div class="project-detail">

                        <span class="detail-label">
                            Partner Organization
                        </span>

                        <span class="detail-value">

                            <% if (project.organization_id) { %>

                                <a
                                    href="/organization/<%= project.organization_id %>"
                                >
                                    <%= project.organization_name || 'View Partner Organization' %>
                                </a>

                            <% } else { %>

                                <%= project.organization_name || 'Not specified' %>

                            <% } %>

                        </span>

                    </div>


                    <!-- Project Location -->

                    <div class="project-detail">

                        <span class="detail-label">
                            Project Location
                        </span>

                        <span class="detail-value">
                            <%= project.location || 'Not specified' %>
                        </span>

                    </div>


                    <!-- Start Date -->

                    <div class="project-detail">

                        <span class="detail-label">
                            Start Date
                        </span>

                        <span class="detail-value">

                            <% if (project.start_date) { %>

                                <%= new Date(project.start_date).toLocaleDateString(
                                    'en-US',
                                    {
                                        year: 'numeric',
                                        month: 'long',
                                        day: 'numeric',
                                        timeZone: 'UTC'
                                    }
                                ) %>

                            <% } else { %>

                                To be announced

                            <% } %>

                        </span>

                    </div>


                    <!-- End Date -->

                    <div class="project-detail">

                        <span class="detail-label">
                            End Date
                        </span>

                        <span class="detail-value">

                            <% if (project.end_date) { %>

                                <%= new Date(project.end_date).toLocaleDateString(
                                    'en-US',
                                    {
                                        year: 'numeric',
                                        month: 'long',
                                        day: 'numeric',
                                        timeZone: 'UTC'
                                    }
                                ) %>

                            <% } else { %>

                                To be announced

                            <% } %>

                        </span>

                    </div>

                </div>


                <!-- =================================================
                     SERVICE CATEGORIES
                ================================================== -->

                <section
                    class="project-categories"
                    aria-label="Currently assigned service categories"
                >

                    <h3>
                        Service Categories
                    </h3>


                    <% if (categories && categories.length > 0) { %>

                        <div class="category-tags">

                            <% categories.forEach(category => { %>

                                <a
                                    class="category-tag"
                                    href="/category/<%= category.category_id %>"
                                >
                                    <%= category.category_name %>
                                </a>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <p class="no-results">
                            No categories have been assigned to this project yet.
                        </p>

                    <% } %>

                </section>


                <!-- =================================================
                     VOLUNTEER REGISTRATION
                     Logged-in users can volunteer or withdraw.
                ================================================== -->

                <section
                    class="project-volunteer-section"
                    aria-label="Volunteer for this service project"
                >

                    <h3>
                        Get Involved
                    </h3>

                    <p>
                        Make a difference in your community by
                        participating in this service project.
                    </p>


                    <% if (user) { %>

                        <% if (volunteering) { %>

                            <!-- User has already volunteered -->

                            <div class="volunteer-status">

                                <p class="success-message">
                                    You are already volunteering
                                    for this project.
                                </p>

                                <form
                                    action="/project/<%= project.project_id %>/unvolunteer"
                                    method="POST"
                                >

                                    <button
                                        type="submit"
                                        class="btn btn-primary"
                                    >
                                        Withdraw from Project
                                    </button>

                                </form>

                            </div>

                        <% } else { %>

                            <!-- User has not volunteered -->

                            <div class="volunteer-registration">

                                <p>
                                    Interested in helping?
                                    Sign up to volunteer for this project.
                                </p>

                                <form
                                    action="/project/<%= project.project_id %>/volunteer"
                                    method="POST"
                                >

                                    <button
                                        type="submit"
                                        class="btn btn-primary"
                                    >
                                        Volunteer for This Project
                                    </button>

                                </form>

                            </div>

                        <% } %>

                    <% } else { %>

                        <!-- Visitor is not logged in -->

                        <p>
                            Please
                            <a href="/login">log in</a>
                            to volunteer for this project.
                        </p>

                        <p>
                            Don't have an account?
                            <a href="/register">Register here</a>.
                        </p>

                    <% } %>

                </section>


                <!-- =================================================
                     ADMINISTRATOR PROJECT MANAGEMENT
                ================================================== -->

                <% if (
                    user &&
                    String(user.role_name || '').toLowerCase() === 'admin'
                ) { %>

                    <div class="project-actions">

                        <a
                            href="/edit-project/<%= project.project_id %>"
                            class="btn btn-primary"
                        >
                            Edit Project
                        </a>


                        <a
                            href="/assign-categories/<%= project.project_id %>"
                            class="btn btn-primary"
                        >
                            Edit Categories
                        </a>

                    </div>

                <% } %>


                <!-- =================================================
                     BACK TO PROJECTS
                ================================================== -->

                <div class="project-actions">

                    <a
                        href="/projects"
                        class="project-link"
                    >
                        Back to Service Projects
                    </a>

                </div>


            </div>

        </article>

    </section>

</main>

<%- include('partials/footer') %>
