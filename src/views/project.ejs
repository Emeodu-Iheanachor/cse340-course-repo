<%- include('partials/header') %>

<main class="project-page">

    <section class="page-intro">
        <h1><%= title %></h1>

        <p>
            Learn more about this service project and the
            organization supporting this opportunity.
        </p>
    </section>


    <section class="project-details" aria-label="Service project details">

        <article class="project-card">

            <div class="project-card-content">

                <p class="project-label">Service Project</p>

                <h2><%= project.title %></h2>


                <div class="project-detail-section">

                    <h3>Description</h3>

                    <p class="project-description">
                        <%= project.description %>
                    </p>

                </div>


                <div class="project-details-list">

                    <div class="project-detail">

                        <span class="detail-label">
                            Partner Organization
                        </span>

                        <span class="detail-value">

                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>

                        </span>

                    </div>


                    <div class="project-detail">

                        <span class="detail-label">
                            Start Date
                        </span>

                        <span class="detail-value">

                            <%= new Date(project.start_date).toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                timeZone: 'UTC'
                            }) %>

                        </span>

                    </div>


                    <% if (project.end_date) { %>

                        <div class="project-detail">

                            <span class="detail-label">
                                End Date
                            </span>

                            <span class="detail-value">

                                <%= new Date(project.end_date).toLocaleDateString('en-US', {
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric',
                                    timeZone: 'UTC'
                                }) %>

                            </span>

                        </div>

                    <% } %>

                </div>


                <div class="project-card-action">

                    <a
                        href="/projects"
                        class="project-link"
                    >
                        Back to Service Projects
                    </a>

                </div>

            </div>

        </article>

    </section>

</main>

<%- include('partials/footer') %>