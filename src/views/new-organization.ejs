<%- include('partials/header') %>

<main>

  <section class="page-intro">

    <h1><%= title %></h1>

    <p>
      Add a new partner organization to the Service Network.
    </p>

  </section>


  <section class="organization-form-page">

    <form
      class="organization-form"
      action="/new-organization"
      method="POST"
    >

      <!-- Organization Name -->
      <div class="form-group">

        <label for="name">
          Organization Name
        </label>

        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="150"
          placeholder="Enter organization name"
          autocomplete="organization"
        >

      </div>


      <!-- Organization Description -->
      <div class="form-group">

        <label for="description">
          Organization Description
        </label>

        <textarea
          id="description"
          name="description"
          required
          maxlength="500"
          placeholder="Enter organization description"
        ></textarea>

      </div>


      <!-- Contact Email -->
      <div class="form-group">

        <label for="contactEmail">
          Contact Email
        </label>

        <input
          type="email"
          id="contactEmail"
          name="contactEmail"
          required
          placeholder="organization@example.com"
          autocomplete="email"
        >

      </div>


      <!-- Form Actions -->
      <div class="form-actions">

        <button type="submit">
          Add Organization
        </button>

        <a
          href="/organizations"
          class="cancel-link"
        >
          Cancel
        </a>

      </div>

    </form>

  </section>

</main>

<%- include('partials/footer') %>
