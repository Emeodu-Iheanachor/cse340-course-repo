<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %> | Service Network</title>

    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

<header class="site-header">

    <nav class="site-nav" aria-label="Main navigation">

    <ul>

        <li>
            <a
                href="/"
                class="<%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>"
            >
                Home
            </a>
        </li>

        <li>
            <a
                href="/organizations"
                class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/organization') ? 'active' : '' %>"
            >
                Our Partner Organizations
            </a>
        </li>

        <li>
            <a
                href="/projects"
                class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/project') ? 'active' : '' %>"
            >
                Service Projects
            </a>
        </li>

        <li>
            <a
                href="/categories"
                class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/categories') ? 'active' : '' %>"
            >
                Service Project Categories
            </a>
        </li>

    </ul>

</nav>

</header>