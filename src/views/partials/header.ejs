<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> | Service Network</title>

    <!-- Favicon -->
    <link
        rel="icon"
        href="/favicon.ico"
        type="image/x-icon"
    >

    <!-- Main Stylesheet -->
    <link
        rel="stylesheet"
        href="/css/main.css"
    >
</head>

<body>

<header class="site-header">
    <div class="header-inner">

        <!-- Site Branding -->
        <a
            href="/"
            class="site-brand"
            aria-label="Service Network home"
        >
            <img
                src="/images/cse340-service-network.png"
                alt="CSE 340 Service Network logo"
                class="site-logo"
            >

            <span class="site-title">
                Service Network
            </span>
        </a>

        <!-- Mobile Navigation Toggle -->
        <button
            class="nav-toggle"
            type="button"
            aria-controls="site-navigation"
            aria-expanded="false"
            aria-label="Open navigation menu"
        >
            ☰
        </button>

        <!-- Main Navigation -->
        <nav
            id="site-navigation"
            class="site-navigation"
            aria-label="Main navigation"
        >

            <!-- Home -->
            <a
                href="/"
                class="<%= currentPath === '/' ? 'active' : '' %>"
                <% if (currentPath === '/') { %>aria-current="page"<% } %>
            >
                Home
            </a>

            <!-- Partner Organizations -->
            <a
                href="/organizations"
                class="<%= currentPath.startsWith('/organization') ? 'active' : '' %>"
                <% if (currentPath.startsWith('/organization')) { %>aria-current="page"<% } %>
            >
                Our Partner Organizations
            </a>

            <!-- Service Projects -->
            <a
                href="/projects"
                class="<%= currentPath.startsWith('/project') ? 'active' : '' %>"
                <% if (currentPath.startsWith('/project')) { %>aria-current="page"<% } %>
            >
                Service Projects
            </a>

            <!-- Service Project Categories -->
            <a
                href="/categories"
                class="<%= currentPath.startsWith('/categor') ? 'active' : '' %>"
                <% if (currentPath.startsWith('/categor')) { %>aria-current="page"<% } %>
            >
                Service Project Categories
            </a>

            <!-- Authentication Navigation -->
            <% if (isLoggedIn && user) { %>

                <!-- Dashboard -->
                <a
                    href="/dashboard"
                    class="<%= currentPath.startsWith('/dashboard') ? 'active' : '' %>"
                    <% if (currentPath.startsWith('/dashboard')) { %>aria-current="page"<% } %>
                >
                    My Dashboard
                </a>

                <!-- Administrator-Only Navigation -->
                <% if (isAdmin) { %>

                    <a
                        href="/users"
                        class="<%= currentPath.startsWith('/users') ? 'active' : '' %>"
                        <% if (currentPath.startsWith('/users')) { %>aria-current="page"<% } %>
                    >
                        Users
                    </a>

                <% } %>

                <!-- Logged-in User -->
                <span class="nav-user">
                    <%= user.name %>
                </span>

                <!-- Logout -->
                <form
                    action="/logout"
                    method="POST"
                    class="logout-form"
                >
                    <button
                        type="submit"
                        class="nav-link-button"
                    >
                        Logout
                    </button>
                </form>

            <% } else { %>

                <!-- Login -->
                <a
                    href="/login"
                    class="<%= currentPath.startsWith('/login') ? 'active' : '' %>"
                    <% if (currentPath.startsWith('/login')) { %>aria-current="page"<% } %>
                >
                    Login
                </a>

                <!-- Register -->
                <a
                    href="/register"
                    class="<%= currentPath.startsWith('/register') ? 'active' : '' %>"
                    <% if (currentPath.startsWith('/register')) { %>aria-current="page"<% } %>
                >
                    Register
                </a>

            <% } %>

        </nav>
    </div>
</header>

<!-- Flash Messages -->
<% if (typeof flash === 'function') { %>

    <% const messages = flash(); %>

    <% Object.keys(messages).forEach(type => { %>

        <% if (Array.isArray(messages[type]) && messages[type].length > 0) { %>

            <div
                class="alert <%= type %>"
                role="alert"
            >
                <% messages[type].forEach(msg => { %>
                    <p><%= msg %></p>
                <% }); %>
            </div>

        <% } %>

    <% }); %>

<% } %>
