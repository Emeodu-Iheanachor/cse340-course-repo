<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %> | Service Network</title>


     <!-- Favicon -->
    <link rel="icon" href="/favicon.ico">

    <link rel="stylesheet" href="/css/main.css">
    
</head>

<body>


<header class="site-header">

    <div class="header-inner">

        <!-- Site Branding -->
        <a href="/" class="site-brand">

            <img
                src="/images/cse340-service-network.png"
                alt="CSE 340 Service Network logo"
                class="site-logo"
            >

            <span class="site-title">
                Service Network
            </span>

        </a>


        <!-- Mobile Navigation Toggle -->
        <button
            class="nav-toggle"
            type="button"
            aria-controls="site-navigation"
            aria-expanded="false"
            aria-label="Open navigation menu"
        >
            ☰
        </button>


        <!-- Main Navigation -->
        <nav
            id="site-navigation"
            class="site-navigation"
            aria-label="Main navigation"
        >

            <!-- Home -->
            <a
                href="/"
                class="<%= currentPath === '/' ? 'active' : '' %>"
            >
                Home
            </a>


            <!-- Organizations -->
            <a
                href="/organizations"
                class="<%= currentPath.startsWith('/organization') ? 'active' : '' %>"
            >
                Our Partner Organizations
            </a>


            <!-- Projects -->
            <a
                href="/projects"
                class="<%= currentPath.startsWith('/project') ? 'active' : '' %>"
            >
                Service Projects
            </a>


            <!-- Categories -->
            <a
                href="/categories"
                class="<%= currentPath.startsWith('/categor') ? 'active' : '' %>"
            >
                Service Project Categories
            </a>


            <!-- Authentication Navigation -->
            <% if (isLoggedIn) { %>

                <!-- Dashboard -->
                <a
                    href="/dashboard"
                    class="<%= currentPath.startsWith('/dashboard') ? 'active' : '' %>"
                >
                    My Dashboard
                </a>


                <!-- Logout -->
                <a
                    href="/logout"
                    class="<%= currentPath.startsWith('/logout') ? 'active' : '' %>"
                >
                    Logout
                </a>

            <% } else { %>

                <!-- Register -->
                <a
                    href="/register"
                    class="<%= currentPath.startsWith('/register') ? 'active' : '' %>"
                >
                    Register
                </a>


                <!-- Login -->
                <a
                    href="/login"
                    class="<%= currentPath.startsWith('/login') ? 'active' : '' %>"
                >
                    Login
                </a>

            <% } %>

        </nav>

    </div>

</header>


<!-- Flash Messages -->
<% const messages = flash(); %>

<% Object.keys(messages).forEach(type => { %>

    <% if (messages[type].length > 0) { %>

        <div
            class="alert <%= type %>"
            role="alert"
        >

            <% messages[type].forEach(msg => { %>
                <%= msg %>
            <% }); %>

        </div>

    <% } %>

<% }); %>
