<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %> | Service Network</title>

    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

<header class="site-header">

    <div class="site-header-inner">

        <a href="/" class="site-brand">
            Service Network
        </a>

        <button
            class="nav-toggle"
            type="button"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="site-navigation"
        >
            <span class="nav-toggle-icon"></span>
        </button>

    </div>

    <nav id="site-navigation">

        <ul>
            <li>
                <a
                    href="/"
                    class="<%= currentPath === '/' ? 'active' : '' %>"
                >
                    Home
                </a>
            </li>

            <li>
                <a
                    href="/organizations"
                    class="<%= currentPath === '/organizations' ? 'active' : '' %>"
                >
                    Our Partner Organizations
                </a>
            </li>

            <li>
                <a
                    href="/projects"
                    class="<%= currentPath === '/projects' ? 'active' : '' %>"
                >
                    Service Projects
                </a>
            </li>

            <li>
                <a
                    href="/categories"
                    class="<%= currentPath === '/categories' ? 'active' : '' %>"
                >
                    Service Project Categories
                </a>
            </li>
        </ul>

    </nav>

</header>


<!-- Flash Messages -->
<% const messages = flash(); %>

<% Object.keys(messages).forEach(type => { %>

    <% if (messages[type].length > 0) { %>

        <div class="alert <%= type %>" role="alert">

            <% messages[type].forEach(msg => { %>
                <%= msg %>
            <% }); %>

        </div>

    <% } %>

<% }); %>
