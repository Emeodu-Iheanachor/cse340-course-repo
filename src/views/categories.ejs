<%- include('partials/header') %>

<main class="categories-page">

    <section class="page-intro">

        <h1><%= title %></h1>

        <p>
            Explore service project categories and discover
            opportunities to make a positive difference in the community.
        </p>

        <div class="page-actions">

            <a
                href="/new-category"
                class="btn-primary"
            >
                Create New Category
            </a>

        </div>

    </section>


    <% if (categories && categories.length > 0) { %>

        <section
            class="categories-list"
            aria-label="Service project categories"
        >

            <% categories.forEach(category => { %>

                <article class="category-card">

                    <h2>
                        <a
                            href="/category/<%= category.category_id %>"
                        >
                            <%= category.category_name %>
                        </a>
                    </h2>


                    <div class="card-actions">

                        <a
                            href="/category/<%= category.category_id %>"
                            class="btn-secondary"
                        >
                            View
                        </a>

                        <a
                            href="/edit-category/<%= category.category_id %>"
                            class="btn-secondary"
                        >
                            Edit
                        </a>

                    </div>

                </article>

            <% }) %>

        </section>


    <% } else { %>

        <p class="no-results">
            No service project categories are currently available.
        </p>

    <% } %>

</main>

<%- include('partials/footer') %>