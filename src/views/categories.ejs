<%- include('partials/header') %>

<main class="categories-page">

    <!-- =====================================================
         PAGE INTRODUCTION
    ====================================================== -->

    <section class="page-intro">

        <h1><%= title %></h1>

        <p>
            Explore service project categories and discover
            opportunities to make a positive difference in the community.
        </p>

        <!-- =================================================
             PAGE ACTIONS
             Only administrators can create categories.
        ================================================== -->

        <% if (isAdmin) { %>

            <div class="page-actions">

                <a
                    href="/new-category"
                    class="btn btn-primary"
                >
                    Create New Category
                </a>

            </div>

        <% } %>

    </section>


    <!-- =====================================================
         CATEGORY LIST
    ====================================================== -->

    <% if (categories && categories.length > 0) { %>

        <section
            class="categories-list"
            aria-label="Service project categories"
        >

            <% categories.forEach(category => { %>

                <article class="category-card">

                    <h2>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.category_name %>
                        </a>
                    </h2>

                    <div class="card-actions">

                        <!-- =================================
                             VIEW CATEGORY
                             Available to all visitors.
                        ================================== -->

                        <a
                            href="/category/<%= category.category_id %>"
                            class="btn btn-secondary"
                        >
                            View
                        </a>

                        <!-- =================================
                             EDIT CATEGORY
                             Only administrators can edit.
                        ================================== -->

                        <% if (isAdmin) { %>

                            <a
                                href="/edit-category/<%= category.category_id %>"
                                class="btn btn-primary"
                            >
                                Edit
                            </a>

                        <% } %>

                    </div>

                </article>

            <% }) %>

        </section>


    <!-- =====================================================
         EMPTY STATE
    ====================================================== -->

    <% } else { %>

        <section class="empty-state">

            <h2>No Service Project Categories Available</h2>

            <p>
                There are currently no service project categories available.
                Please check back later.
            </p>

        </section>

    <% } %>

</main>

<%- include('partials/footer') %>
