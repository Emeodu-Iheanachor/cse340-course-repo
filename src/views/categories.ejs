<%- include('partials/header') %>

<main class="categories-page">

    <section class="page-intro">
        <h1><%= title %></h1>

        <p>
            Explore service project categories and discover
            opportunities to make a positive difference in the community.
        </p>
    </section>

    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>

        <section class="categories-list" aria-label="Service project categories">

            <% categories.forEach(category => { %>

                <article class="category-card">
                    <h2><%= category.category_name %></h2>
                </article>

            <% }); %>

        </section>

    <% } else { %>

        <p>No categories are currently available.</p>

    <% } %>

</main>

<%- include('partials/footer') %>